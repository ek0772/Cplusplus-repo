using namespace std;
int size=10;

int findMax(const int staticArray[], int size) {
/**
 * @brief Calculates the max value in the array
 * @param Confined to the static array, based on its size.
 * @return None (void).
 */
int i;
int maxVal = staticArray[0];
for (i = 0; i < size; ++i) {  
    if (staticArray[i] > maxVal) {
        maxVal = staticArray[i];
    }
}
return maxVal;
}

float calculateAverage(const int staticArray[], int size) {
/**
 * @brief Calculates the average from all 10 values
 * @param Confined to the static array, based on its size.
 * @return The average value
 */
int sum=0;
int i;
for (i = 0; i < size;) {
    sum=sum+staticArray[i];
    i=i+1;
}
int average=sum/10;
return average;
}

int findMin(const int staticArray[], int size) {
/**
 * @brief Calculates the minimum value from the array
 * @param Confined to the static array, based on its size.
 * @return Minimum value.
 */
int minVal = staticArray[0];
int i;
for (i = 0; i < size; ++i) {
    if (staticArray[i] < minVal) {
        minVal = staticArray[i];
    }
}
return minVal;
}

void arraySolution() {
/**
 * @brief Calculates the statistics using arrays
 * @param None.
 * @return None (void).
 */
int staticArray[10];
int score;
int i;
for (i = 0; i < 10;) {
    cin >> score;
    if (score>=0 && score<=100) {
        staticArray[i]=score;
        i++;
    }
    else {
        cin >> score;
    }
}
int maxValue=findMax(staticArray,10);
cout << "Highest score: " << maxValue << endl;
int minValue=findMin(staticArray,10);
cout << "Lowest score: " << minValue << endl;
float averageVal=calculateAverage(staticArray,10);
cout << "Average score: " << averageVal << endl;
}

float vectorAverage(const vector<int>& vec) {
/**
 * @brief Calculate the average with the vector list.
 * @param using the vector and the size of itself.
 * @return vegAvg average value.
 */
int sum = 0;
for (int value : vec) {
    sum = sum + value;
}
float vecAvg = sum/vec.size();
return vecAvg;
}

int vectorMax(const vector<int>& vec) {
/**
 * @brief Calculate the maximum value from the vector list.
 * @param Limited by size of vector.
 * @return  Reutrns maxVec
 */
int maxVec= vec[0];
for (int i = 0; i < vec.size(); i++) {
    if (vec[i] >maxVec) {
    maxVec=vec[i];
    }
}
return maxVec;
}

int vectorMin(const vector<int>& vec) {
/**
 * @brief finds the MINIMUM vector value
 * @param limited by size of vector
 * @return minVal, the smallest value
 */
int minVal = vec[0];
    for (size_t i = 1; i < vec.size(); i++) {
        if (vec[i] < minVal) {
            minVal = vec[i];
        }
    }
    return minVal;
}

void vectorSolution() {
/**
 * @brief Calculates the statistics using a dynamic vector.
 * @param None.
 * @return None (void).
 */
vector<int> vectorList{};
int userinput=0;
cout << "Please enter scores one at a time, and enter '-1' to indicate you are done." << endl;
while (userinput != -1) {
    cin >> userinput;
    if (userinput>=0 && userinput<=100) {
        vectorList.push_back(userinput);
    }
    else if (userinput == -1) {
        cout << "exit value detected" <<endl;
    }
    else {
        cout << "invalid value. Please try again." << endl;
    }
}
int maxVec=vectorMax(vectorList);
cout << "Highest score: " << maxVec << endl;
int minVec=vectorMin(vectorList);
cout << "Lowest score: " << minVec << endl;
float averageVec=vectorAverage(vectorList);
cout << "Average score: " << averageVec << endl;
}

